{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake --build --preset Debug",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/flash.ps1\"",
            "problemMatcher": []
        },
        {
            "label": "Build & Flash",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build",
                "Flash"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
